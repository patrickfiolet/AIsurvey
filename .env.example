# ============================================================
# AIsurvey.me v2.0 — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/aisurvey_v2?schema=public"

# --- NextAuth.js ---
NEXTAUTH_SECRET="generate-a-secure-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# --- Abacus.AI (LLM Engine) ---
ABACUSAI_API_KEY="your-abacus-ai-api-key"
# Optional: max milliseconds to wait for the LLM API before aborting (default 30000)
LLM_TIMEOUT_MS="30000"

# --- VAPI (Voice Agent) ---
VAPI_API_KEY="your-vapi-api-key"
VAPI_WEBHOOK_SECRET="your-vapi-webhook-secret"
VAPI_PHONE_NUMBER_ID="your-vapi-phone-number-id"

# --- Application ---
NODE_ENV="development"
APP_NAME="aisurvey.me"
DEFAULT_LANGUAGE="nl"

# --- Knowledge-OS Integration (v2.0) ---
EDI_API_URL="http://localhost:4000/api"
EDI_API_KEY="your-edi-api-key"
LEARNING_ME_API_URL="http://localhost:5000/api"
LEARNING_ME_API_KEY="your-learning-me-api-key"
KNOWLEDGE_OS_EVENT_BUS_URL="http://localhost:6000"
