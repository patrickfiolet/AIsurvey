generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int         @id @default(autoincrement())
  email      String      @unique
  name       String?
  password   String
  role       UserRole    @default(ADMIN)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  surveys    Survey[]
  agentCalls AgentCall[]

  @@map("users")
}

model Survey {
  id                  Int                  @id @default(autoincrement())
  title               String               @default("AI Survey")
  description         String               @default("Help ons uw organisatie beter te begrijpen")
  welcomeText         String               @default("Welkom bij onze AI-gedreven survey. Uw antwoorden helpen ons waardevolle inzichten te verkrijgen.")
  thankYouText        String               @default("Dank u voor uw deelname! Uw antwoorden zijn opgeslagen en zullen bijdragen aan waardevolle inzichten.")
  isActive            Boolean              @default(true)
  isAnonymous         Boolean              @default(false)
  surveyType          SurveyType           @default(STATIC)
  createdById         Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdBy           User?                @relation(fields: [createdById], references: [id])
  questions           Question[]
  voiceAgentQuestions VoiceAgentQuestion[]
  responses           Response[]
  analyses            Analysis[]
  conversations       Conversation[]
  agentCalls          AgentCall[]

  @@map("surveys")
}

model Question {
  id         Int          @id @default(autoincrement())
  surveyId   Int
  title      String
  type       QuestionType @default(OPEN_TEXT)
  options    String[]     @default([])
  isRequired Boolean      @default(true)
  order      Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  survey     Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@map("questions")
}

model VoiceAgentQuestion {
  id        Int                @id @default(autoincrement())
  surveyId  Int
  title     String
  order     Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  survey    Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers   VoiceAgentAnswer[]

  @@map("voice_agent_questions")
}

model Response {
  id                Int                  @id @default(autoincrement())
  surveyId          Int
  respondentName    String?
  respondentEmail   String?
  isCompleted       Boolean              @default(false)
  status            SurveyResponseStatus @default(IN_PROGRESS)
  lastAnsweredPhase String?
  progressPercent   Int                  @default(0)
  conversationId    Int?                 @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  survey            Survey               @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers           Answer[]
  conversation      Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@map("responses")
}

model Answer {
  id             Int      @id @default(autoincrement())
  responseId     Int
  questionId     Int
  textValue      String?
  selectedOption String?
  ratingValue    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  response       Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model VoiceAgentAnswer {
  id          Int                @id @default(autoincrement())
  agentCallId Int
  questionId  Int
  textValue   String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  agentCall   AgentCall          @relation(fields: [agentCallId], references: [id], onDelete: Cascade)
  question    VoiceAgentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("voice_agent_answers")
}

model Analysis {
  id              Int      @id @default(autoincrement())
  surveyId        Int
  title           String   @default("AI Survey Analyse")
  themes          Json?
  patterns        Json?
  problems        Json?
  bestPractices   Json?
  knowledgeGaps   Json?
  recommendations Json?
  summary         String?
  metadata        Json?
  generatedAt     DateTime @default(now())
  survey          Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@map("analyses")
}

model Conversation {
  id                Int                    @id @default(autoincrement())
  surveyId          Int
  respondentName    String?
  respondentEmail   String?
  isCompleted       Boolean                @default(false)
  currentPhase      String                 @default("opening")
  contextData       Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  survey            Survey                 @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  messages          ConversationMessage[]
  extractedEntities ExtractedEntity[]
  metadata          ConversationMetadata[]
  response          Response?

  @@map("conversations")
}

model ConversationMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  role           MessageRole
  content        String       @db.Text
  questionPhase  String?
  metadataTag    String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_messages")
}

model ExtractedEntity {
  id             Int          @id @default(autoincrement())
  conversationId Int
  entityType     String
  entityValue    String
  context        String?      @db.Text
  sourcePhase    String?
  sentiment      String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("extracted_entities")
}

model ConversationMetadata {
  id             Int          @id @default(autoincrement())
  conversationId Int
  metadataKey    String
  metadataValue  String       @db.Text
  phase          String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_metadata")
}

model AgentCall {
  id              Int                @id @default(autoincrement())
  surveyId        Int
  userId          Int?
  vapiCallId      String?            @unique
  firstName       String?
  lastName        String?
  phoneNumber     String?
  dailyActivities String?            @db.Text
  challenges      String?            @db.Text
  tomorrowActions String?            @db.Text
  transcript      String?            @db.Text
  duration        Int?
  status          CallStatus         @default(IN_PROGRESS)
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  survey          Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  user            User?              @relation(fields: [userId], references: [id])
  answers         VoiceAgentAnswer[]

  @@map("agent_calls")
}

model Translation {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   Int
  language   String
  fieldName  String   @default("")
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, language, fieldName])
  @@index([entityType, entityId])
  @@index([language])
  @@map("translations")
}

model DynamicTranslationCache {
  id             Int      @id @default(autoincrement())
  sourceText     String   @db.Text
  sourceHash     String
  targetLang     String
  translatedText String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sourceHash, targetLang])
  @@index([sourceHash])
  @@index([targetLang])
  @@map("dynamic_translation_cache")
}

enum SurveyType {
  STATIC
  CONVERSATIONAL
  VOICE_AGENT
}

enum CallStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
}

enum MessageRole {
  AI
  USER
}

enum SurveyResponseStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum QuestionType {
  OPEN_TEXT
  MULTIPLE_CHOICE
  RATING_SCALE
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}
